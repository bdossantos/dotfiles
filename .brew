#!/usr/bin/env bash

set -o errexit
set -o pipefail
set -o nounset

DEBUG=${DEBUG:=0}
[[ $DEBUG -eq 1 ]] && set -o xtrace

export HOMEBREW_NO_ANALYTICS=1
export HOMEBREW_NO_AUTO_UPDATE=1
export HOMEBREW_NO_INSECURE_REDIRECT=1
export PATH="${HOME}/.homebrew/bin:${PATH}"

CPU_BRAND="$(sysctl -n machdep.cpu.brand_string)"
export CPU_BRAND

echo "--> Detected CPU Brand: ${CPU_BRAND}"

echo "--> Make sure we're using the latest Homebrew"
brew update

echo '--> Upgrade any already-installed formulae'
brew upgrade

echo '--> Install all brew formulae'
brew install \
  ack \
  advancecomp \
  ansifilter \
  ast-grep \
  autoenv \
  awscli \
  bash \
  bash-completion@2 \
  bat \
  bazel \
  binutils \
  cheat \
  cli53 \
  closure-compiler \
  coreutils \
  ctags \
  curl \
  diff-so-fancy \
  diffutils \
  ed \
  editorconfig \
  entr \
  eza \
  fd \
  findomain \
  findutils \
  fzf \
  gawk \
  gcc \
  gcloud-cli \
  gifsicle \
  git \
  gitlint \
  gnu-indent \
  gnu-sed \
  gnu-tar \
  gnu-which \
  go-jsonnet \
  gpatch \
  gpg \
  grep \
  gsl \
  gzip \
  hadolint \
  htmlcompressor \
  htop \
  ipcalc \
  jhead \
  jpeg \
  jpegoptim \
  jq \
  k9s \
  kops \
  kubectx \
  lazygit \
  less \
  lesspipe \
  libyaml \
  logcli \
  luarocks \
  make \
  miller \
  mise \
  moreutils \
  nmap \
  openssh \
  openssl \
  optipng \
  packer \
  pigz \
  pngcrush \
  pngquant \
  pre-commit \
  prettier \
  pv \
  pwgen \
  readline \
  ripgrep \
  ruff \
  s3cmd \
  shellcheck \
  shfmt \
  shpotify \
  ssh-copy-id \
  starship \
  tcpdump \
  terminal-notifier \
  tfenv \
  the_silver_searcher \
  tig \
  tldr \
  tree \
  vale \
  vim \
  watch \
  wget \
  xz \
  zoxide

# Apps, fonts and system-wide casks are installed by mise (brew-cask), see
# ~/.config/mise/conf.d/packages.toml and ~/.config/mise/system-casks.toml:
#   mise bootstrap packages apply --manager brew-cask

# Install tool versions declared in ~/.config/mise/config.toml
if command -v mise &>/dev/null; then
  mise install
fi

# Disable the macOS default ssh-agent for your user.
launchctl disable user/$UID/com.openssh.ssh-agent
