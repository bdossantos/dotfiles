#!/usr/bin/env bash

set -o errexit
set -o pipefail
set -o nounset

DEBUG=${DEBUG:=0}
[[ $DEBUG -eq 1 ]] && set -o xtrace

export HOMEBREW_NO_ANALYTICS=1
export HOMEBREW_NO_AUTO_UPDATE=1
export HOMEBREW_NO_INSECURE_REDIRECT=1
export PATH="${HOME}/.homebrew/bin:${PATH}"

CPU_BRAND="$(sysctl -n machdep.cpu.brand_string)"
export CPU_BRAND

echo "--> Detected CPU Brand: ${CPU_BRAND}"

echo "--> Make sure we're using the latest Homebrew"
brew update

echo '--> Upgrade any already-installed formulae'
brew upgrade

echo '--> Install all brew formulae'
brew install \
  ack \
  advancecomp \
  ansifilter \
  autoenv \
  bash \
  bash-completion@2 \
  binutils \
  closure-compiler \
  coreutils \
  ctags \
  curl \
  diffutils \
  ed \
  editorconfig \
  entr \
  findomain \
  findutils \
  gawk \
  gcc \
  gcloud-cli \
  gifsicle \
  git \
  gnu-indent \
  gnu-sed \
  gnu-tar \
  gnu-which \
  gpatch \
  gpg \
  grep \
  gsl \
  gzip \
  htmlcompressor \
  htop \
  ipcalc \
  jhead \
  jpeg \
  jpegoptim \
  less \
  lesspipe \
  libyaml \
  luarocks \
  make \
  mise \
  moreutils \
  nmap \
  openssh \
  openssl \
  optipng \
  pigz \
  pngcrush \
  pngquant \
  pv \
  pwgen \
  readline \
  shpotify \
  ssh-copy-id \
  tcpdump \
  terminal-notifier \
  the_silver_searcher \
  tig \
  tree \
  vim \
  watch \
  wget \
  xz

# Apps, fonts and system-wide casks are installed by mise (brew-cask), see
# ~/.config/mise/conf.d/packages.toml and ~/.config/mise/system-casks.toml:
#   mise bootstrap packages apply --manager brew-cask

# Install tool versions declared in ~/.config/mise/config.toml
if command -v mise &>/dev/null; then
  mise install
fi

# Disable the macOS default ssh-agent for your user.
launchctl disable user/$UID/com.openssh.ssh-agent
